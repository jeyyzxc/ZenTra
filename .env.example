# Runtime
NODE_ENV=development
DEPLOYMENT_ENV=development
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_at_least_32_random_bytes

# PostgreSQL / Prisma
# Local development may use PostgreSQL directly on port 5432.
# On Vercel, DATABASE_URL must use Supabase's transaction pooler on port 6543.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true
# Prisma migrations use the direct/session connection on port 5432, never the 6543 transaction pooler.
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_POOL_MAX=3
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=10000

# Supabase Storage (server-only)
SUPABASE_URL=https://PROJECT_REF.supabase.co
# Prefer the modern sb_secret_ key. The legacy service-role key is supported during migration.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PAYMENT_PROOFS_BUCKET=payment-proofs
SUPABASE_TESTIMONY_PHOTOS_BUCKET=testimony-photos
SUPABASE_PROFILE_MEDIA_BUCKET=profile-media
SUPABASE_COMMAND_CENTER_DRAFTS_BUCKET=command-center-drafts
SUPABASE_ASSISTANT_DOCUMENTS_BUCKET=assistant-source-documents
SUPABASE_PUBLIC_CONTENT_BUCKET=public-content-media

# Application-to-n8n authentication
BOOKING_ORCHESTRATION_API_KEY=replace_with_secure_random_secret
BACKEND_ORCHESTRATION_SECRET=replace_with_secure_random_secret
N8N_WEBHOOK_SECRET=replace_with_secure_random_secret
N8N_WEBHOOK_ENABLED=true
N8N_WEBHOOK_TIMEOUT_MS=8000

# n8n public webhooks
N8N_BOOKING_WEBHOOK_URL=http://localhost:5678/webhook/zion-booking-created
N8N_CONTRACT_DELIVERY_WEBHOOK_URL=
N8N_CONTRACT_RESEND_WEBHOOK_URL=
N8N_TEAM_ACCESS_WEBHOOK_URL=
N8N_CLIENT_ACCESS_WEBHOOK_URL=
# Keep false in Vercel Preview unless Preview has isolated n8n and data.
ALLOW_PREVIEW_AUTOMATION=false

# Public business identity included in orchestration payloads
ZION_LOGO_URL=
ZION_SUPPORT_EMAIL=
ZION_SUPPORT_PHONE=
ZION_SOCIAL_LINK=

# Smart Assistant (server-only)
GEMINI_API_KEY=
GEMINI_SIMPLE_MODEL=gemini-3.1-flash-lite
GEMINI_COMPLEX_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
CLIENT_ACCESS_HASH_SECRET=replace_with_secure_random_secret
# Development only. Leave empty in Preview and Production.
CLIENT_ACCESS_DEV_CODE=

# Required in Production for PDF/DOCX knowledge ingestion
DOCUMENT_MALWARE_SCANNER_URL=
DOCUMENT_MALWARE_SCANNER_SECRET=

# Optional app-side email provider. Current production delivery is configured in n8n.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_PROVIDER_API_KEY=

# Initial Super Admin seed; remove/rotate SUPERADMIN_PASSWORD after first use.
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_EMAIL=
SUPERADMIN_FULL_NAME=Zentra Superadmin
SUPERADMIN_PASSWORD=

# Optional local-only Next.js build directory override.
NEXT_DIST_DIR=
