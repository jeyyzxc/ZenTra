  emailLogId     String?     @map("email_log_id")
  workflowLogId  String?     @map("workflow_log_id")
  recipientEmail String      @map("recipient_email")
  status         EmailStatus @default(PENDING)
  attemptNumber  Int         @map("attempt_number")
  errorMessage   String?     @map("error_message") @db.Text
  sentAt         DateTime?   @map("sent_at")
  createdAt      DateTime    @default(now()) @map("created_at")

  @@index([contractId])
  @@index([emailLogId])
  @@index([workflowLogId])
  @@index([status])
  @@index([createdAt])
  @@map("contract_send_attempts")
}

model DashboardTask {
  id              String                @id @default(cuid())
  title           String
  description     String?               @db.Text
  taskDate        DateTime              @map("task_date")
  taskTime        String?               @map("task_time")
  priority        DashboardTaskPriority @default(MEDIUM)
  status          DashboardTaskStatus   @default(PENDING)
  assignedTo      String?               @map("assigned_to")
  assignedToRole  String?               @map("assigned_to_role")
  relatedModule   String?               @map("related_module")
  relatedRecordId String?               @map("related_record_id")
  bookingReference String?              @map("booking_reference")
  category        String?
  source          DashboardTaskSource   @default(MANUAL)
