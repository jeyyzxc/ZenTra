  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([contractId])
  @@index([createdAt])
  @@map("contract_timeline")
}

model ContractSendAttempt {
  id             String      @id @default(cuid())
  contractId     String      @map("contract_id")
