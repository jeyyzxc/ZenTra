model PaymentRecord {
  id                 String                    @id @default(cuid())
  paymentReference   String                    @unique @map("payment_reference")
  bookingId          String                    @unique @map("booking_id")
  booking            Booking                   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingReference   String                    @map("booking_reference")
  clientName         String                    @map("client_name")
  clientEmail        String?                   @map("client_email")
  clientPhone        String?                   @map("client_phone") @db.VarChar(20)
  eventTitle         String?                   @map("event_title")
  eventType          String?                   @map("event_type")
  eventDate          DateTime?                 @map("event_date")
  packageName        String?                   @map("package_name")
  paymentType        PaymentType?              @map("payment_type")
  status             PaymentSummaryStatus      @default(UNPAID)
  verificationStatus PaymentVerificationStatus @default(NOT_SUBMITTED) @map("verification_status")
  totalAmount        Float                     @default(0) @map("total_amount")
  amountPaid         Float                     @default(0) @map("amount_paid")
  pendingAmount      Float                     @default(0) @map("pending_amount")
  remainingBalance   Float                     @default(0) @map("remaining_balance")
  paymentMethod      String?                   @map("payment_method")
  paymentDate        DateTime?                 @map("payment_date")
  dueDate            DateTime?                 @map("due_date")
  proofPath          String?                   @map("proof_path") @db.Text
  proofFileName      String?                   @map("proof_file_name")
  proofFileType      String?                   @map("proof_file_type")
  proofUploadedBy    String?                   @map("proof_uploaded_by")
  proofUploadedAt    DateTime?                 @map("proof_uploaded_at")
  verifiedBy         String?                   @map("verified_by")
  verifiedAt         DateTime?                 @map("verified_at")
  notes              String?                   @db.Text
  source             String                    @db.VarChar(80)
  createdBy          String?                   @map("created_by")
  updatedBy          String?                   @map("updated_by")
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")
  history            PaymentHistory[]
  milestones         PaymentMilestone[]

  @@index([status])
  @@index([verificationStatus])
  @@index([paymentType])
  @@index([bookingReference])
  @@index([dueDate])
  @@index([paymentDate])
  @@index([createdAt])
  @@map("payment_records")
}

model PaymentHistory {
  id            String                     @id @default(cuid())
  paymentId     String                     @map("payment_id")
  payment       PaymentRecord              @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  bookingId     String?                    @map("booking_id")
  action        String
  description   String                     @db.Text
  oldStatus     PaymentSummaryStatus?      @map("old_status")
  newStatus     PaymentSummaryStatus?      @map("new_status")
  oldAmount     Float?                     @map("old_amount")
  newAmount     Float?                     @map("new_amount")
  oldBalance    Float?                     @map("old_balance")
  newBalance    Float?                     @map("new_balance")
  paymentAmount Float?                     @map("payment_amount")
  paymentType   PaymentType?               @map("payment_type")
  paymentMethod String?                    @map("payment_method")
  proofPath     String?                    @map("proof_path") @db.Text
  proofFileName String?                    @map("proof_file_name")
  proofFileType String?                    @map("proof_file_type")
  previousValue Json?                      @map("previous_value")
  newValue      Json?                      @map("new_value")
  verification  PaymentVerificationStatus? @map("verification_status")
  performedBy   String                     @map("performed_by")
  notes         String?                    @db.Text
  source        String                     @db.VarChar(80)
  createdAt     DateTime                   @default(now()) @map("created_at")

  @@index([paymentId])
  @@index([bookingId])
  @@index([action])
  @@index([createdAt])
  @@map("payment_history")
}

model PaymentMilestone {
  id             String                 @id @default(cuid())
  paymentId      String                 @map("payment_id")
  payment        PaymentRecord          @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  bookingId      String                 @map("booking_id")
  milestoneName  String                 @map("milestone_name")
  amountRequired Float                  @default(0) @map("amount_required")
  amountPaid     Float                  @default(0) @map("amount_paid")
  dueDate        DateTime?              @map("due_date")
  status         PaymentMilestoneStatus @default(PENDING)
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  @@index([paymentId])
  @@index([bookingId])
  @@index([dueDate])
  @@index([status])
  @@map("payment_milestones")
}

model N8nWorkflowLog {
  id                  String            @id @default(cuid())
  workflowName        String            @map("workflow_name")
  workflowExecutionId String?           @map("workflow_execution_id")
  relatedModule       String?           @map("related_module")
  relatedRecordId     String?           @map("related_record_id")
  triggerSource       String?           @map("trigger_source")
  requestPayload      Json?             @map("request_payload")
  responsePayload     Json?             @map("response_payload")
  status              N8nWorkflowStatus @default(PROCESSING)
  errorMessage        String?           @map("error_message") @db.Text
  startedAt           DateTime?         @map("started_at")
  completedAt         DateTime?         @map("completed_at")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  @@index([createdAt])
  @@index([status])
  @@index([workflowName])
  @@index([workflowExecutionId])
  @@index([relatedModule, relatedRecordId])
  @@index([createdAt, status])
