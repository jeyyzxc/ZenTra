model Contract {
  id                 String                  @id @default(cuid())
  contractNumber     String                  @unique @map("contract_number")
  bookingId          String                  @map("booking_id")
  booking            Booking                 @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingReference   String                  @map("booking_reference")
  clientName         String                  @map("client_name")
  clientEmail        String?                 @map("client_email")
  eventType          String                  @map("event_type")
  eventDate          DateTime                @map("event_date")
  packageName        String?                 @map("package_name")
  templateId         String?                 @map("template_id")
  template           ContractTemplate?       @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateVersion    Int                     @default(1) @map("template_version")
  contractStatus     ContractStatus          @default(DRAFT) @map("contract_status")
  emailStatus        EmailStatus?            @map("email_status")
  workflowStatus     ContractWorkflowStatus  @default(NOT_STARTED) @map("workflow_status")
  signatureStatus    ContractSignatureStatus @default(NOT_SENT) @map("signature_status")
  contractAmount     Float?                  @map("contract_amount")
  totalPaid          Float?                  @map("total_paid")
  remainingBalance   Float?                  @map("remaining_balance")
  pdfUrl             String?                 @map("pdf_url") @db.Text
  htmlPreview        String?                 @map("html_preview") @db.Text
  snapshotData       Json?                   @map("snapshot_data")
  resendAttemptCount Int                     @default(0) @map("resend_attempt_count")
  lastSentAt         DateTime?               @map("last_sent_at")
  lastResendAt       DateTime?               @map("last_resend_at")
  signedAt           DateTime?               @map("signed_at")
  viewedAt           DateTime?               @map("viewed_at")
  generatedBy        String?                 @map("generated_by")
  sentBy             String?                 @map("sent_by")
  internalNotes      String?                 @map("internal_notes") @db.Text
  source             String?                 @db.VarChar(80)
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")
  versions           ContractVersion[]
  timeline           ContractTimeline[]
  sendAttempts       ContractSendAttempt[]

  @@index([bookingId])
  @@index([bookingReference])
  @@index([clientEmail])
  @@index([contractStatus])
  @@index([emailStatus])
  @@index([workflowStatus])
  @@index([signatureStatus])
  @@index([eventDate])
  @@index([createdAt])
  @@map("contracts")
}

model ContractVersion {
  id              String   @id @default(cuid())
  contractId      String   @map("contract_id")
  contract        Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  versionNumber   Int      @map("version_number")
  templateVersion Int      @map("template_version")
  snapshotData    Json     @map("snapshot_data")
  pdfUrl          String?  @map("pdf_url") @db.Text
  htmlPreview     String?  @map("html_preview") @db.Text
  changeSummary   String?  @map("change_summary") @db.Text
  createdBy       String?  @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([contractId, versionNumber])
  @@index([contractId])
  @@index([createdAt])
  @@map("contract_versions")
}

model ContractTemplate {
  id                 String               @id @default(cuid())
  templateName       String               @map("template_name")
  templateType       ContractTemplateType @default(EVENT_CONTRACT) @map("template_type")
  templateVersion    Int                  @default(1) @map("template_version")
  eventType          String?              @map("event_type")
  htmlTemplate       String               @map("html_template") @db.Text
  staticTermsContent String?              @map("static_terms_content") @db.Text
  isActive           Boolean              @default(true) @map("is_active")
  lockedSections     Json?                @map("locked_sections")
  createdBy          String?              @map("created_by")
  updatedBy          String?              @map("updated_by")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  contracts          Contract[]

  @@index([templateType])
  @@index([templateVersion])
  @@index([eventType])
  @@index([isActive])
  @@map("contract_templates")
}

model ContractTimeline {
  id          String   @id @default(cuid())
  contractId  String   @map("contract_id")
  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  action      String
