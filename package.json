{
  "name": "zentra",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "postinstall": "prisma generate",
    "test:booking-orchestration": "node --import tsx --test services/booking-orchestration/booking-categorization.service.test.ts",
    "test:task-templates": "node --import tsx --test services/task-template/task-template.service.test.ts",
    "test:task-templates:integration": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server --import tsx --test services/task-template/task-template.integration.test.ts",
    "test:command-center": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server --import tsx --test services/command-center/command-center-foundation.test.ts",
    "test:exports": "node --import tsx --test lib/export/export-utils.test.ts",
    "lint": "node --max-old-space-size=4096 ./node_modules/eslint/bin/eslint.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "node prisma/seed.mjs",
    "db:production:status": "node --env-file=.env.production.local ./node_modules/prisma/build/index.js migrate status",
    "db:production:check": "node --env-file=.env.production.local scripts/check-production-database.mjs",
    "db:production:deploy": "node --env-file=.env.production.local ./node_modules/prisma/build/index.js migrate deploy",
    "db:production:seed": "node --env-file=.env.production.local prisma/seed.mjs --production",
    "db:clean-except-users": "tsx scripts/clean-database-except-users.ts",
    "env:check:preview": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/validate-deployment-env.mjs preview",
    "env:check:production": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/validate-deployment-env.mjs production",
    "env:check:production:file": "node --env-file=.env.production.local scripts/validate-deployment-env.mjs production",
    "deploy:verify": "npm run typecheck && npm run test:booking-orchestration && npm run test:task-templates && npm run test:command-center && npm run test:exports && npm run build"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.17.0",
    "mammoth": "^1.11.0",
    "next": "^16.2.10",
    "next-auth": "^4.24.14",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.10",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}
